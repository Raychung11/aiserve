# AiServe ESG OS — Apache URL Rewriting
# Upload to public_html/ on Hostinger
# Enables clean URLs: /dashboard instead of /index.php?page=dashboard

Options -Indexes
Options +FollowSymLinks

RewriteEngine On

# Base path — update if installed in a subdirectory
# e.g. if installed at yourdomain.com/esg/ use: RewriteBase /esg/
RewriteBase /

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Exclude asset files from rewriting
RewriteRule ^(assets|favicon\.ico)(/.*)?$ - [L]

# Rewrite all other requests to index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options SAMEORIGIN
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy strict-origin-when-cross-origin
</IfModule>

# Protect sensitive files
<FilesMatch "\.(sql|log|env|md|json|lock)$">
  Require all denied
</FilesMatch>

# Protect config directory
<FilesMatch "^(config|src|includes|db)/">
  Require all denied
</FilesMatch>

# PHP settings for Hostinger
<IfModule mod_php8.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 20M
  php_value max_execution_time 60
  php_value memory_limit 256M
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
