# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ebizmedic"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-this"
JWT_EXPIRY="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Zoom (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID="your-zoom-account-id"
ZOOM_CLIENT_ID="your-zoom-client-id"
ZOOM_CLIENT_SECRET="your-zoom-client-secret"
ZOOM_WEBHOOK_SECRET_TOKEN="your-zoom-webhook-secret"

# Redis (for BullMQ queues and caching)
REDIS_URL="redis://localhost:6379"

# Email (SMTP)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="eBizMedic <noreply@ebizmedic.com>"

# Object Storage (AWS S3 / Cloudflare R2 / Wasabi)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="ebizmedic-recordings"
STORAGE_REGION="ap-southeast-1"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_ENDPOINT=""

# Recording retention (days)
RECORDING_RETENTION_DAYS="90"
