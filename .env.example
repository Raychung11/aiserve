APP_NAME="STRHub AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_CURRENCY=MYR

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=strhub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@strhub.my"
MAIL_FROM_NAME="${APP_NAME}"

BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SANDBOX=true
BILLPLZ_X_SIGNATURE=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

PLATFORM_REVENUE_SHARE_PCT=15
PLATFORM_SUBSCRIPTION_STARTER=500
PLATFORM_SUBSCRIPTION_GROWTH=1500
PLATFORM_SUBSCRIPTION_ENTERPRISE=4000
