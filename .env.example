# Copy this file to `.env` and place it TWO directories above the project root
# (the same location config/openai.php loads from), then fill in real values.
# NEVER commit the real .env — it is git-ignored.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# --- Evolution / WhatsApp webhook ---
# Shared secret required on incoming webhook requests (apikey header,
# X-Webhook-Secret header, or ?secret= query param). Leave blank to keep the
# webhook open (NOT recommended once WhatsApp is live).
EVOLUTION_WEBHOOK_SECRET=
